{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles, so let TS resolve like a bundler (no .js extensions needed).
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
