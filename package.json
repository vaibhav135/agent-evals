{
  "name": "agent-evals",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "bun run --filter @agent-evals/shared build",
    "dev:api": "bun run --filter @agent-evals/api dev",
    "dev:web": "bun run --filter @agent-evals/web dev",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
