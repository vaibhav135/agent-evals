{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM output. The CommonJS Nest API loads it via Node's require(esm)
    // (Node >= 22.12), so one build serves both the API and Vite.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"]
}
