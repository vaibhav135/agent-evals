# Copy to .env and fill in. docker compose and the API both read it.

# Required: the only LLM provider this project is tested with.
ANTHROPIC_API_KEY=

# Postgres from docker-compose.yml, exposed on host port 5433 (5432 is often
# taken by a local install). Inside compose the api uses postgres:5432.
DATABASE_URL=postgres://evals:evals@localhost:5433/evals

# API
PORT=3000
